# Copy to .env and fill in real values. Never commit .env.

# Which provider answers questions (retrieval itself needs no LLM/API key -
# see embeddings.py): "glm" (default, free tier via z.ai), "gemini", or
# "anthropic".
CHAT_PROVIDER=glm

GLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Where the Chroma vector store persists its data.
CHROMA_PERSIST_DIR=./data/chroma
