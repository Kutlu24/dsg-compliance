# Copy to .env and fill in real values. Never commit .env.

# Which provider answers questions: "glm" (default, free tier via z.ai),
# "gemini", or "anthropic".
CHAT_PROVIDER=glm

# GEMINI_API_KEY is always required - embeddings.py uses it for retrieval
# (Gemini's free embedding API) regardless of which CHAT_PROVIDER answers.
GLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Where the Chroma vector store persists its data.
CHROMA_PERSIST_DIR=./data/chroma
